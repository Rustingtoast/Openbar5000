import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PlaylistView, PlaylistRow, PlaylistChoice } from "playlist_view.slint";
import { TransportBar, PlaybackButtons, SeekBar, SeekSlider, PlaybackOptions } from "transport_bar.slint";
import { InfoView, InfoRow, LyricsView, LyricLine, PlaceholderView, TabStripView, ArtistView, ArtistCandidate } from "side_panels.slint";
import { StatusBar } from "status_bar.slint";
import { WaveformSeekbar } from "waveform_seekbar.slint";
import { SpectrumView, SpectrumNote } from "spectrum_view.slint";
import { NowPlayingBar, AlbumArtView } from "now_playing.slint";
import { PropertiesWindow, PropertyField, DetailRow, ArtworkRow } from "properties_window.slint";
import { AboutWindow } from "about_window.slint";
import { SettingsWindow, ThemeListEntry } from "settings_window.slint";
import { ThemeEditorWindow } from "theme_editor_window.slint";
import { LyricsEditorWindow } from "lyrics_editor_window.slint";
import { VintageEqualizer, Vfd } from "vintage_equalizer.slint";
import { LibraryView, LibraryRow } from "library_view.slint";
import { LoadingOverlay } from "loading_overlay.slint";
import { PlaylistManagerWindow, PlaylistManagerRow } from "playlist_manager_window.slint";

/// One placed panel (see `app::layout`): which panel to draw and where,
/// relative to the panel area below the menu bar.
export struct PanelSlot {
    kind: string,
    label: string,
    x: length,
    y: length,
    width: length,
    height: length,
    // For "Move Left/Right" vs "Move Up/Down": whether the split holding
    // this panel lays it out side by side, and which ways it can go.
    move-side-by-side: bool,
    can-move-back: bool,
    can-move-forward: bool,
}

/// Where a dragged panel will land, highlighted while dragging.
export struct DropPreview {
    visible: bool,
    label: string,
    x: length,
    y: length,
    width: length,
    height: length,
}

/// A tab group's strip of tab buttons (see `app::layout::TabStrip`).
export struct TabStripSlot {
    labels: [string],
    active: int,
    x: length,
    y: length,
    width: length,
    height: length,
}

/// A draggable boundary between two panels, shown while editing the
/// layout. `side-by-side`: the panels sit left/right of it, so it's a
/// vertical bar dragged horizontally.
export struct LayoutDivider {
    side-by-side: bool,
    // Shown (as a thin line you can drag) even outside edit mode -- between
    // big side-by-side panels like the tabs and the playlist.
    separator: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

/// An entry in a panel's "Replace with" menu -- the panel registry.
export struct SortChoice {
    id: string,
    title: string,
    checked: bool,
}

export struct PanelChoice {
    id: string,
    label: string,
}

export { Vfd, PropertyField, DetailRow, ArtworkRow, LibraryRow, PlaylistManagerWindow, PlaylistManagerRow, PlaylistRow, PropertiesWindow, AboutWindow, SettingsWindow, ThemeListEntry, ThemeEditorWindow, LyricsEditorWindow, Theme }

export component MainWindow inherits Window {
    // Set from Cargo.toml's version at startup (see `app::wiring`).
    in property <string> app-version;
    title: root.app-version == "" ? "Openbar5000" : "Openbar5000 v" + root.app-version;
    icon: Theme.logo;
    preferred-width: 1400px;
    preferred-height: 700px;
    min-width: 760px;
    min-height: 500px;
    // Slint's winit backend only makes a window resizable when its computed
    // max size is strictly greater than its min size on at least one axis
    // (see `window_is_resizable` in i-slint-backend-winit). Without an
    // explicit `max-*` here, `min-width` above made max collapse to it and
    // locked the window.
    max-width: 100000px;
    max-height: 100000px;
    background: Theme.bg-base;

    // Every window keeps std-widgets (Button/CheckBox/LineEdit/MenuBar/...)
    // in the built-in style matching the active `Theme`, instead of
    // following the OS's own light/dark setting -- otherwise default-styled
    // widgets would fight the Theme-driven hardcoded colors everywhere else
    // (e.g. default Text color turning white against a light theme panel).
    // `app::theme::apply_theme` sets this whenever the theme changes.
    in property <bool> theme-is-dark: true;
    init => {
        Palette.color-scheme = root.theme-is-dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed theme-is-dark => {
        Palette.color-scheme = root.theme-is-dark ? ColorScheme.dark : ColorScheme.light;
    }

    in property <[PlaylistRow]> playlist-rows: [];
    in property <bool> is-playing: false;
    in property <float> position-seconds: 0;
    in property <float> duration-seconds: 0;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <float> volume: 1.0;
    in property <bool> shuffle-active: false;
    in property <bool> loop-active: false;
    in property <bool> repeat-one-active: false;
    in property <string> status-text: "Openbar5000 — an open-source foobar2000-alike";

    in property <[PanelSlot]> panel-slots: [];
    in property <[LayoutDivider]> layout-dividers: [];
    in property <[PanelChoice]> panel-choices: [];
    in property <[TabStripSlot]> tab-strips: [];
    // Tab press/drag/release: strip index, tab index, and positions
    // relative to the panel area. A release without a drag is a click.
    callback tab-drag-pressed(int, int, length, length);
    callback tab-drag-moved(length, length);
    callback tab-drag-released();
    callback panel-add-tab-clicked(int);

    in property <[InfoRow]> track-info: [];
    in property <[LyricLine]> lyric-lines: [];
    in property <int> lyric-active-line: -1;
    in property <bool> lyrics-synced: false;
    in property <string> lyric-status: "Nothing playing";
    // "Add lyrics…" / "Edit lyrics…" in the LYR panel (needs a track).
    in property <bool> lyrics-editable: false;
    callback edit-lyrics-clicked();

    // Artist information (BIO panel, see `app::artist_info`).
    in property <string> artist-state: "nothing";
    in property <string> artist-name;
    in property <string> artist-meta;
    in property <string> artist-genres;
    in property <string> artist-summary;
    in property <image> artist-photo;
    in property <bool> artist-has-photo: false;
    in property <string> artist-link-label;
    in property <string> artist-credit;
    in property <string> artist-message;
    in property <[ArtistCandidate]> artist-candidates: [];
    callback artist-lookup-clicked();
    callback artist-link-clicked();
    callback artist-candidate-clicked(int);
    callback artist-none-of-these-clicked();
    in property <bool> layout-editing: false;
    in property <[string]> waveform-paths: [];
    in property <int> waveform-bucket-count: 1;
    in property <[float]> spectrum-bars: [];
    in property <[float]> spectrum-peaks: [];
    in property <[SpectrumNote]> spectrum-notes: [];
    in property <int> spectrum-min-db: -80;
    in property <int> spectrum-max-db: 0;
    in property <string> now-playing-text;
    in property <image> album-art;
    in property <bool> has-album-art: false;
    in property <bool> album-art-loading: false;

    callback play-pause-clicked();
    callback menu-play-clicked();
    callback menu-pause-clicked();
    callback stop-clicked();
    callback next-clicked();
    callback previous-clicked();
    callback seek-requested(float);
    callback volume-changed(float);
    callback shuffle-clicked();
    callback loop-clicked();
    callback row-clicked(int);
    callback row-properties-clicked(int);
    callback row-open-folder-clicked(int);
    callback row-remove-clicked(int);
    callback row-cut-clicked(int);
    callback row-copy-clicked(int);
    callback row-enqueue-clicked(int);
    callback group-toggle-clicked(string);
    callback collapse-all-clicked();
    callback expand-all-clicked();
    callback grouping-clicked(string);
    callback sort-clicked(string);
    callback show-now-playing-clicked();
    callback refresh-playlist-clicked();
    callback search-edited(string);
    in property <string> playlist-grouping: "artist-album-disc";
    in property <bool> playlist-list-view: false;
    // The Sorting menu (see `app::playlist_rows::SortMode`).
    in property <[SortChoice]> sort-choices: [];
    callback sorting-chosen(string);
    in property <string> playlist-summary: "";
    // Playlists (issue #33): the summary bar's menu, File > New Playlist,
    // File > Playlist Manager.
    in property <[PlaylistChoice]> playlist-choices: [];
    in property <string> playlist-name;
    callback row-selected(int, bool, bool);
    callback playlist-chosen(int);
    callback new-playlist-clicked();
    callback playlist-manager-clicked();
    callback send-to-playlist(int, int);
    callback send-to-new-playlist(int);

    // The playlist lives inside a panel slot, where it can't be addressed
    // by id; bumping the serial asks whichever playlist panel exists to
    // scroll to `playlist-scroll-y`.
    in-out property <int> playlist-scroll-serial: 0;
    in-out property <length> playlist-scroll-y: 0;
    public function scroll-playlist-to(y: length) {
        root.playlist-scroll-y = y;
        root.playlist-scroll-serial += 1;
    }

    callback panel-area-resized(length, length);
    // Read once at startup: `panel-area`'s init runs before the Rust side
    // has connected `panel-area-resized`.
    out property <length> panel-area-width: panel-area.width;
    out property <length> panel-area-height: panel-area.height;
    callback layout-edit-toggled();
    callback layout-reset-clicked();
    // Panel actions take the slot's index in `panel-slots`.
    callback panel-replace-clicked(int, string);
    callback panel-split-clicked(int, bool);
    callback panel-remove-clicked(int);
    // Divider drags report window coordinates along the drag axis, so the
    // delta stays right while the divider itself moves under the pointer.
    callback divider-pressed(int, length);
    callback divider-moved(length);
    callback divider-released();
    callback panel-move-clicked(int, bool);
    // Dragging a panel (edit mode): positions are relative to the panel area.
    callback panel-drag-pressed(int, length, length);
    callback panel-drag-moved(length, length);
    callback panel-drag-released();
    in property <DropPreview> drop-preview;
    // Equalizer (issue #7): Playback > Equalizer and the Vintage
    // Equalizer panel, both driven by `app::equalizer`.
    in property <bool> eq-enabled: false;
    in property <[string]> eq-band-labels: [];
    in property <string> eq-lit-dots;
    in property <string> eq-half-dots;
    in property <string> eq-dim-dots;
    in property <string> eq-readout-band;
    in property <string> eq-readout-gain;
    in property <string> eq-message-dots;
    in property <int> eq-message-columns;
    in property <string> eq-grid-dots;
    in property <int> eq-grid-columns;
    // Media library (LIB panel, see `app::media_library`).
    in property <[LibraryRow]> library-rows: [];
    in property <[string]> library-groupings: [];
    in property <int> library-grouping-index: 0;
    in property <string> library-status;
    in property <bool> library-has-folders: false;
    in property <int> library-selected: -1;
    callback library-grouping-changed(int);
    callback library-search-edited(string);
    callback library-row-clicked(int);
    callback library-row-toggled(int);
    callback library-row-activated(int);
    callback library-row-add-clicked(int);
    callback library-collapse-all-clicked();
    callback library-rescan-clicked();
    callback library-add-folder-clicked();
    callback library-folders-clicked();

    callback eq-settings-clicked();
    callback eq-enabled-toggled();
    callback eq-step(int, int);
    callback eq-flat-clicked();

    // The loading card (see `LoadingOverlay`); total 0 while still unknown.
    in property <bool> loading-active: false;
    in property <string> loading-title;
    in property <int> loading-done;
    in property <int> loading-total;

    callback open-files-clicked();
    callback open-folder-clicked();
    callback properties-clicked();
    callback clear-playlist-clicked();
    callback about-clicked();
    callback settings-clicked();
    callback exit-clicked();

    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Open Files..."; activated => { root.open-files-clicked(); } }
            MenuItem { title: "Open Folder..."; activated => { root.open-folder-clicked(); } }
            MenuSeparator {}
            MenuItem { title: "New Playlist"; activated => { root.new-playlist-clicked(); } }
            MenuItem { title: "Playlist Manager..."; activated => { root.playlist-manager-clicked(); } }
            MenuSeparator {}
            MenuItem { title: "Preferences..."; activated => { root.settings-clicked(); } }
            MenuSeparator {}
            MenuItem { title: "Exit"; activated => { root.exit-clicked(); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Properties..."; activated => { root.properties-clicked(); } }
            MenuSeparator {}
            MenuItem { title: "Clear Playlist"; activated => { root.clear-playlist-clicked(); } }
        }
        Menu {
            title: "Playback";
            MenuItem { title: "Play"; activated => { root.menu-play-clicked(); } }
            MenuItem { title: "Pause"; activated => { root.menu-pause-clicked(); } }
            MenuItem { title: "Stop"; activated => { root.stop-clicked(); } }
            MenuSeparator {}
            MenuItem { title: "Previous"; activated => { root.previous-clicked(); } }
            MenuItem { title: "Next"; activated => { root.next-clicked(); } }
            MenuSeparator {}
            Menu {
                title: "Equalizer";
                MenuItem {
                    title: "Enable Equalizer";
                    checkable: true;
                    checked: root.eq-enabled;
                    activated => { root.eq-enabled-toggled(); }
                }
                MenuItem { title: "Equalizer Settings..."; activated => { root.eq-settings-clicked(); } }
            }
        }
        Menu {
            title: "Sorting";
            // Rebuilt by the app after every choice: activating a checkable
            // item toggles its own `checked`, which would otherwise leave
            // stale check marks behind.
            for choice in root.sort-choices: MenuItem {
                title: choice.title;
                checkable: true;
                checked: choice.checked;
                activated => { root.sorting-chosen(choice.id); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: root.layout-editing ? "Finish Editing Layout" : "Edit Layout";
                activated => { root.layout-edit-toggled(); }
            }
            MenuItem { title: "Reset Layout"; activated => { root.layout-reset-clicked(); } }
            MenuSeparator {}
            MenuItem { title: "Preferences..."; activated => { root.settings-clicked(); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "About Openbar5000..."; activated => { root.about-clicked(); } }
        }
    }

    panel-area := Rectangle {
        changed width => { root.panel-area-resized(self.width, self.height); }
        changed height => { root.panel-area-resized(self.width, self.height); }

        for slot[slot-index] in root.panel-slots: Rectangle {
            x: slot.x;
            y: slot.y;
            width: slot.width;
            height: slot.height;
            clip: true;

            if slot.kind == "playlist": PlaylistView {
                width: parent.width;
                height: parent.height;
                rows: root.playlist-rows;
                grouping: root.playlist-grouping;
                list-view: root.playlist-list-view;
                summary: root.playlist-summary;
                playlists: root.playlist-choices;
                playlist-name: root.playlist-name;
                row-selected(i, range, toggle) => { root.row-selected(i, range, toggle); }
                playlist-chosen(i) => { root.playlist-chosen(i); }
                new-playlist-clicked => { root.new-playlist-clicked(); }
                playlist-manager-clicked => { root.playlist-manager-clicked(); }
                send-to-playlist(track, playlist) => { root.send-to-playlist(track, playlist); }
                send-to-new-playlist(track) => { root.send-to-new-playlist(track); }
                scroll-serial: root.playlist-scroll-serial;
                scroll-y: root.playlist-scroll-y;
                row-clicked(i) => { root.row-clicked(i); }
                row-properties-clicked(i) => { root.row-properties-clicked(i); }
                row-open-folder-clicked(i) => { root.row-open-folder-clicked(i); }
                row-remove-clicked(i) => { root.row-remove-clicked(i); }
                row-cut-clicked(i) => { root.row-cut-clicked(i); }
                row-copy-clicked(i) => { root.row-copy-clicked(i); }
                row-enqueue-clicked(i) => { root.row-enqueue-clicked(i); }
                group-toggle-clicked(key) => { root.group-toggle-clicked(key); }
                collapse-all-clicked => { root.collapse-all-clicked(); }
                expand-all-clicked => { root.expand-all-clicked(); }
                grouping-clicked(id) => { root.grouping-clicked(id); }
                sort-clicked(id) => { root.sort-clicked(id); }
                show-now-playing-clicked => { root.show-now-playing-clicked(); }
                refresh-playlist-clicked => { root.refresh-playlist-clicked(); }
                search-edited(text) => { root.search-edited(text); }
            }
            if slot.kind == "waveform": WaveformSeekbar {
                width: parent.width;
                height: parent.height;
                channel-paths: root.waveform-paths;
                bucket-count: root.waveform-bucket-count;
                position-seconds: root.position-seconds;
                duration-seconds: root.duration-seconds;
                seek-requested(pos) => { root.seek-requested(pos); }
            }
            if slot.kind == "spectrum": SpectrumView {
                width: parent.width;
                height: parent.height;
                bars: root.spectrum-bars;
                peaks: root.spectrum-peaks;
                notes: root.spectrum-notes;
                min-db: root.spectrum-min-db;
                max-db: root.spectrum-max-db;
            }
            if slot.kind == "transport": TransportBar {
                width: parent.width;
                height: parent.height;
                is-playing: root.is-playing;
                position-seconds: root.position-seconds;
                duration-seconds: root.duration-seconds;
                position-text: root.position-text;
                duration-text: root.duration-text;
                volume: root.volume;
                shuffle-active: root.shuffle-active;
                loop-active: root.loop-active;
                repeat-one-active: root.repeat-one-active;
                play-pause-clicked => { root.play-pause-clicked(); }
                stop-clicked => { root.stop-clicked(); }
                next-clicked => { root.next-clicked(); }
                previous-clicked => { root.previous-clicked(); }
                seek-requested(pos) => { root.seek-requested(pos); }
                volume-changed(v) => { root.volume-changed(v); }
                shuffle-clicked => { root.shuffle-clicked(); }
                loop-clicked => { root.loop-clicked(); }
            }
            if slot.kind == "now-playing": NowPlayingBar {
                width: parent.width;
                height: parent.height;
                text: root.now-playing-text;
            }
            if slot.kind == "album-art": AlbumArtView {
                width: parent.width;
                height: parent.height;
                art: root.album-art;
                has-art: root.has-album-art;
                loading: root.album-art-loading;
            }
            if slot.kind == "playback-buttons": PlaybackButtons {
                width: parent.width;
                height: parent.height;
                is-playing: root.is-playing;
                play-pause-clicked => { root.play-pause-clicked(); }
                stop-clicked => { root.stop-clicked(); }
                next-clicked => { root.next-clicked(); }
                previous-clicked => { root.previous-clicked(); }
                open-files-clicked => { root.open-files-clicked(); }
                open-folder-clicked => { root.open-folder-clicked(); }
            }
            if slot.kind == "seek-bar": SeekBar {
                width: parent.width;
                height: parent.height;
                position-seconds: root.position-seconds;
                duration-seconds: root.duration-seconds;
                position-text: root.position-text;
                volume: root.volume;
                shuffle-active: root.shuffle-active;
                loop-active: root.loop-active;
                repeat-one-active: root.repeat-one-active;
                seek-requested(pos) => { root.seek-requested(pos); }
                volume-changed(v) => { root.volume-changed(v); }
                shuffle-clicked => { root.shuffle-clicked(); }
                loop-clicked => { root.loop-clicked(); }
            }
            if slot.kind == "seek-slider": SeekSlider {
                width: parent.width;
                height: parent.height;
                position-seconds: root.position-seconds;
                duration-seconds: root.duration-seconds;
                seek-requested(pos) => { root.seek-requested(pos); }
            }
            if slot.kind == "playback-options": PlaybackOptions {
                width: parent.width;
                height: parent.height;
                position-seconds: root.position-seconds;
                duration-seconds: root.duration-seconds;
                position-text: root.position-text;
                volume: root.volume;
                shuffle-active: root.shuffle-active;
                loop-active: root.loop-active;
                repeat-one-active: root.repeat-one-active;
                volume-changed(v) => { root.volume-changed(v); }
                shuffle-clicked => { root.shuffle-clicked(); }
                loop-clicked => { root.loop-clicked(); }
            }
            if slot.kind == "info": InfoView {
                width: parent.width;
                height: parent.height;
                rows: root.track-info;
            }
            if slot.kind == "lyrics": LyricsView {
                width: parent.width;
                height: parent.height;
                lines: root.lyric-lines;
                active-line: root.lyric-active-line;
                synced: root.lyrics-synced;
                status: root.lyric-status;
                editable: root.lyrics-editable;
                edit-clicked => { root.edit-lyrics-clicked(); }
            }
            if slot.kind == "biography": ArtistView {
                width: parent.width;
                height: parent.height;
                state: root.artist-state;
                artist: root.artist-name;
                meta: root.artist-meta;
                genres: root.artist-genres;
                summary: root.artist-summary;
                photo: root.artist-photo;
                has-photo: root.artist-has-photo;
                link-label: root.artist-link-label;
                credit: root.artist-credit;
                message: root.artist-message;
                candidates: root.artist-candidates;
                lookup-clicked => { root.artist-lookup-clicked(); }
                link-clicked => { root.artist-link-clicked(); }
                candidate-clicked(i) => { root.artist-candidate-clicked(i); }
                none-of-these-clicked => { root.artist-none-of-these-clicked(); }
            }
            if slot.kind == "library": LibraryView {
                width: parent.width;
                height: parent.height;
                rows: root.library-rows;
                groupings: root.library-groupings;
                grouping-index: root.library-grouping-index;
                status: root.library-status;
                has-folders: root.library-has-folders;
                selected: root.library-selected;
                grouping-changed(i) => { root.library-grouping-changed(i); }
                search-edited(text) => { root.library-search-edited(text); }
                row-clicked(i) => { root.library-row-clicked(i); }
                row-toggled(i) => { root.library-row-toggled(i); }
                row-activated(i) => { root.library-row-activated(i); }
                row-add-clicked(i) => { root.library-row-add-clicked(i); }
                collapse-all-clicked => { root.library-collapse-all-clicked(); }
                rescan-clicked => { root.library-rescan-clicked(); }
                add-folder-clicked => { root.library-add-folder-clicked(); }
                folders-clicked => { root.library-folders-clicked(); }
            }
            if slot.kind == "equalizer": VintageEqualizer {
                width: parent.width;
                height: parent.height;
                band-labels: root.eq-band-labels;
                enabled: root.eq-enabled;
                lit-dots: root.eq-lit-dots;
                half-dots: root.eq-half-dots;
                dim-dots: root.eq-dim-dots;
                readout-band: root.eq-readout-band;
                readout-gain: root.eq-readout-gain;
                message-dots: root.eq-message-dots;
                message-columns: root.eq-message-columns;
                grid-dots: root.eq-grid-dots;
                grid-columns: root.eq-grid-columns;
                step(band, delta) => { root.eq-step(band, delta); }
                power-clicked => { root.eq-enabled-toggled(); }
                flat-clicked => { root.eq-flat-clicked(); }
            }
            if slot.kind == "status-bar": StatusBar {
                width: parent.width;
                height: parent.height;
                text: root.status-text;
            }

            // While editing: outline + name over each panel and the layout
            // menu on right-click. The drag handle sits *below* the menu
            // area: a TouchArea takes every button, so inside it would
            // swallow the right-click too; here it only gets what the menu
            // area declines -- left clicks, which start a panel drag and
            // stay off the panel itself.
            if root.layout-editing: TouchArea {
                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.panel-drag-pressed(slot-index,
                            self.absolute-position.x + self.mouse-x - panel-area.absolute-position.x,
                            self.absolute-position.y + self.mouse-y - panel-area.absolute-position.y);
                    } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                        root.panel-drag-released();
                    }
                }
                moved => {
                    root.panel-drag-moved(
                        self.absolute-position.x + self.mouse-x - panel-area.absolute-position.x,
                        self.absolute-position.y + self.mouse-y - panel-area.absolute-position.y);
                }
            }
            if root.layout-editing: ContextMenuArea {
                Menu {
                    Menu {
                        title: "Replace with";
                        for choice in root.panel-choices: MenuItem {
                            title: choice.label;
                            checkable: true;
                            checked: choice.id == slot.kind;
                            activated => { root.panel-replace-clicked(slot-index, choice.id); }
                        }
                    }
                    if slot.can-move-back: MenuItem {
                        title: slot.move-side-by-side ? "Move Left" : "Move Up";
                        activated => { root.panel-move-clicked(slot-index, false); }
                    }
                    if slot.can-move-forward: MenuItem {
                        title: slot.move-side-by-side ? "Move Right" : "Move Down";
                        activated => { root.panel-move-clicked(slot-index, true); }
                    }
                    if slot.can-move-back || slot.can-move-forward: MenuSeparator {}
                    MenuItem { title: "Add Tab"; activated => { root.panel-add-tab-clicked(slot-index); } }
                    MenuItem { title: "Split Side by Side"; activated => { root.panel-split-clicked(slot-index, true); } }
                    MenuItem { title: "Split Top and Bottom"; activated => { root.panel-split-clicked(slot-index, false); } }
                    MenuSeparator {}
                    MenuItem { title: "Remove Panel"; activated => { root.panel-remove-clicked(slot-index); } }
                    MenuSeparator {}
                    MenuItem { title: "Reset Layout"; activated => { root.layout-reset-clicked(); } }
                    MenuItem { title: "Finish Editing Layout"; activated => { root.layout-edit-toggled(); } }
                }
                Rectangle {
                    background: Theme.bg-sunken.transparentize(0.25);
                    border-width: 1px;
                    border-color: Theme.accent;
                    Text {
                        text: slot.label;
                        color: Theme.text-primary;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
            if !root.layout-editing && slot.kind == "empty": Text {
                text: "Empty panel -- View > Edit Layout to choose one";
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        for strip[strip-index] in root.tab-strips: TabStripView {
            x: strip.x;
            y: strip.y;
            width: strip.width;
            height: strip.height;
            labels: strip.labels;
            active: strip.active;
            tab-pressed(tab, x, y) => { root.tab-drag-pressed(strip-index, tab, strip.x + x, strip.y + y); }
            tab-moved(x, y) => { root.tab-drag-moved(strip.x + x, strip.y + y); }
            tab-released => { root.tab-drag-released(); }
        }

        // Drop target while dragging a panel (edit mode) or a tab.
        if root.drop-preview.visible: Rectangle {
            x: root.drop-preview.x;
            y: root.drop-preview.y;
            width: root.drop-preview.width;
            height: root.drop-preview.height;
            background: Theme.accent.transparentize(0.55);
            border-width: 2px;
            border-color: Theme.accent;
            Text {
                text: root.drop-preview.label;
                color: Theme.accent-text;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        for divider[divider-index] in root.layout-dividers: Rectangle {
            x: divider.x;
            y: divider.y;
            width: divider.width;
            height: divider.height;

            if root.layout-editing || divider.separator: Rectangle {
            // Edit mode: a highlighted handle. Otherwise a 1px line
            // centered in the (wider, invisible) grab area.
            background: root.layout-editing
                ? (drag-area.has-hover || drag-area.pressed ? Theme.accent : Theme.accent.transparentize(0.5))
                : transparent;
            if !root.layout-editing: Rectangle {
                x: divider.side-by-side ? (parent.width - self.width) / 2 : 0;
                y: divider.side-by-side ? 0 : (parent.height - self.height) / 2;
                width: divider.side-by-side ? 1px : parent.width;
                height: divider.side-by-side ? parent.height : 1px;
                background: drag-area.has-hover || drag-area.pressed
                    ? Theme.accent
                    : Theme.text-muted.transparentize(0.7);
            }
            drag-area := TouchArea {
                mouse-cursor: divider.side-by-side ? MouseCursor.col-resize : MouseCursor.row-resize;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.divider-pressed(divider-index, divider.side-by-side
                            ? self.absolute-position.x + self.mouse-x
                            : self.absolute-position.y + self.mouse-y);
                    } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                        root.divider-released();
                    }
                }
                moved => {
                    root.divider-moved(divider.side-by-side
                        ? self.absolute-position.x + self.mouse-x
                        : self.absolute-position.y + self.mouse-y);
                }
            }
            }
        }
    }

    // Over everything: progress while a playlist loads.
    LoadingOverlay {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        active: root.loading-active;
        title: root.loading-title;
        done: root.loading-done;
        total: root.loading-total;
    }
}
