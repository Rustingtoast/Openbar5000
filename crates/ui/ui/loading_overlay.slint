import { Theme } from "theme.slint";

/// A modal progress card over the whole window while a playlist loads:
/// "Loading playlist…", a progress bar, "123 of 456 tracks". With no total
/// yet (a folder still being scanned) the bar runs back and forth instead.
/// It fades in only after a moment, so a quick load doesn't flash it.
export component LoadingOverlay inherits Rectangle {
    in property <bool> active;
    in property <string> title: "Loading playlist\u{2026}";
    in property <int> done;
    in property <int> total;

    property <float> fraction: root.total > 0 ? Math.clamp(root.done / root.total, 0, 1) : 0;

    // Swallows clicks while loading, so nothing changes under the card.
    TouchArea {
        enabled: root.active;
        visible: root.active;
    }

    backdrop := Rectangle {
        background: #000000.transparentize(0.55);
        opacity: 0;

        card := Rectangle {
            width: 380px;
            height: 124px;
            border-radius: 8px;
            background: Theme.bg-raised;
            border-width: 1px;
            border-color: Theme.text-muted.transparentize(0.75);
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000.transparentize(0.5);

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.title;
                    font-size: 15px;
                    font-weight: 600;
                    color: Theme.text-primary;
                }
                // The bar.
                Rectangle {
                    height: 8px;
                    border-radius: 4px;
                    background: Theme.text-muted.transparentize(0.8);
                    clip: true;
                    if root.total > 0: Rectangle {
                        x: 0;
                        width: parent.width * root.fraction;
                        border-radius: 4px;
                        background: Theme.accent;
                        animate width { duration: 150ms; }
                    }
                    // Unknown total: a segment sweeping across.
                    if root.total <= 0 && root.active: Rectangle {
                        property <length> segment: parent.width * 0.3;
                        property <float> phase: Math.mod(animation-tick() / 1ms, 1400) / 1400;
                        x: -self.segment + (parent.width + self.segment) * self.phase;
                        width: self.segment;
                        border-radius: 4px;
                        background: Theme.accent;
                    }
                }
                Text {
                    text: root.total > 0
                        ? root.done + " of " + root.total + " tracks"
                        : "Looking for audio files\u{2026}";
                    font-size: 12px;
                    color: Theme.text-muted;
                }
            }
        }
    }

    states [
        shown when root.active: {
            backdrop.opacity: 1;
            in {
                // Only once loading has taken a moment.
                animate backdrop.opacity { duration: 150ms; delay: 250ms; }
            }
            out {
                animate backdrop.opacity { duration: 120ms; }
            }
        }
    ]
}
