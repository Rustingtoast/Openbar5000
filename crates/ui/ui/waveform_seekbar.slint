import { Theme } from "theme.slint";

/// The track's waveform as outlines, one lane per channel (like the
/// reference UI): each lane traces the highest and lowest sample of every
/// time slice. The played part is shaded; clicking seeks.
export component WaveformSeekbar inherits Rectangle {
    /// One SVG path per channel, in a `bucket-count` x [-1, 1] coordinate
    /// space (built in `app::wiring`).
    in property <[string]> channel-paths: [];
    in property <int> bucket-count: 1;
    in property <float> position-seconds: 0;
    in property <float> duration-seconds: 1;
    callback seek-requested(float);

    property <float> played: root.duration-seconds > 0
        ? Math.clamp(root.position-seconds / root.duration-seconds, 0, 1) : 0;
    property <length> lane-height: (root.height - 8px) / Math.max(1, root.channel-paths.length);

    height: 80px;
    background: Theme.bg-sunken;

    // The played part, mapped exactly like the marker and clicks below.
    Rectangle {
        x: 4px;
        width: (root.width - 8px) * root.played;
        background: Theme.accent.transparentize(0.88);
    }

    for path[i] in root.channel-paths: Path {
        x: 4px;
        y: 4px + i * root.lane-height + 2px;
        width: root.width - 8px;
        height: root.lane-height - 4px;
        commands: path;
        viewbox-x: 0;
        viewbox-y: -1;
        viewbox-width: root.bucket-count;
        viewbox-height: 2;
        fit: fill;
        stroke: Theme.accent;
        stroke-width: 1px;
        fill: transparent;
    }

    // Playback position.
    if root.duration-seconds > 0: Rectangle {
        x: 4px + (root.width - 8px) * root.played;
        width: 1px;
        background: Theme.text-primary.transparentize(0.4);
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.seek-requested(Math.clamp((self.mouse-x - 4px) / (self.width - 8px), 0, 1) * root.duration-seconds);
        }
    }
}
