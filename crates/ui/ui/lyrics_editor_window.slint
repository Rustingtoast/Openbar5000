import { Button, GroupBox, Palette, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

/// Add or edit the playing track's lyrics and save them into the file
/// (issue #6), modelled on the reference UI's lyric editor.
/// "Synchronise selected line" stamps the line under the cursor with the
/// current playback time ([mm:ss.xx], LRC style) and moves to the next.
export component LyricsEditorWindow inherits Window {
    title: (root.text != root.original ? "\u{2022} " : "") + "Lyrics Editor" + (root.track-title == "" ? "" : " \u{2014} " + root.track-title);
    icon: Theme.logo;
    preferred-width: 900px;
    preferred-height: 640px;
    min-width: 640px;
    min-height: 420px;
    max-width: 100000px;
    max-height: 100000px;
    background: Theme.bg-raised;

    in property <bool> theme-is-dark: true;
    init => {
        Palette.color-scheme = root.theme-is-dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed theme-is-dark => {
        Palette.color-scheme = root.theme-is-dark ? ColorScheme.dark : ColorScheme.light;
    }

    in property <string> track-title;
    /// "Ctrl+" -- or the Command key's sign on macOS, for the shortcuts.
    property <string> mod: Platform.os == OperatingSystemType.macos ? "\u{2318}" : "Ctrl+";
    /// The text as saved, to tell unsaved changes by.
    in property <string> original;
    /// The line of `text` being sung right now, if it's synced.
    in property <string> singing-now;
    /// The lyrics being edited; two-way bound to the text field.
    in-out property <string> text;
    /// UTF-8 byte offset of the text cursor: tells the app which line is
    /// "selected". Moved with `place-cursor`.
    out property <int> cursor: input.cursor-position-byte-offset;
    public function place-cursor(offset: int) {
        input.set-selection-offsets(offset, offset);
        input.focus();
    }
    in property <string> playback-time: "0:00";
    in property <bool> is-playing: false;
    /// "Saving…", "Saved", or what went wrong.
    in property <string> status;
    in property <bool> busy: false;

    callback sync-clicked();
    callback remove-timestamp-clicked();
    callback seek-back-clicked();
    callback seek-forward-clicked();
    /// All timestamps earlier (negative) or later by this many ms.
    callback shift-clicked(int);
    callback play-pause-clicked();
    callback undo-clicked();
    callback ok-clicked();
    callback apply-clicked();
    callback cancel-clicked();

    // Shortcuts work while typing: syncing a song is one key per line.
    keys := FocusScope {
      capture-key-pressed(event) => {
        if event.modifiers.control && !event.modifiers.shift && event.text == Key.Return {
            if !root.busy { root.sync-clicked(); }
            return accept;
        }
        if event.modifiers.control && event.modifiers.shift && event.text == Key.Backspace {
            if !root.busy { root.remove-timestamp-clicked(); }
            return accept;
        }
        // Ctrl+P, not Ctrl+Space: on macOS that's Spotlight's (and Slint
        // reports Command as Ctrl there).
        if event.modifiers.control && !event.modifiers.shift && (event.text == "p" || event.text == "P") {
            root.play-pause-clicked();
            return accept;
        }
        if event.modifiers.alt && event.text == Key.LeftArrow {
            root.seek-back-clicked();
            return accept;
        }
        if event.modifiers.alt && event.text == Key.RightArrow {
            root.seek-forward-clicked();
            return accept;
        }
        reject
      }
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        VerticalLayout {
            width: 220px;
            spacing: 10px;
            alignment: start;

            GroupBox {
                title: "Synchronise";
                VerticalLayout {
                    spacing: 6px;
                    Button {
                        text: "Synchronise selected line";
                        enabled: !root.busy;
                        clicked => { root.sync-clicked(); input.focus(); }
                    }
                    Button {
                        text: "Remove timestamp";
                        enabled: !root.busy;
                        clicked => { root.remove-timestamp-clicked(); input.focus(); }
                    }
                    Text {
                        text: "Stamps the current time on the cursor's line, then moves to the next.\n" + root.mod + "Enter: stamp \u{2022} " + root.mod + "Shift+Backspace: remove";
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.text-muted;
                    }
                    Text {
                        text: "Shift all timestamps";
                        font-size: 11px;
                        color: Theme.text-primary;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button {
                            text: "\u{2212}0.1 s";
                            enabled: !root.busy;
                            clicked => { root.shift-clicked(-100); input.focus(); }
                        }
                        Button {
                            text: "+0.1 s";
                            enabled: !root.busy;
                            clicked => { root.shift-clicked(100); input.focus(); }
                        }
                    }
                }
            }

            GroupBox {
                title: "Playback";
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Playback time: " + root.playback-time;
                        color: Theme.text-primary;
                    }
                    Text {
                        text: root.singing-now == "" ? "" : "Singing now: " + root.singing-now;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.accent;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Button { text: "«"; clicked => { root.seek-back-clicked(); } }
                        Button {
                            text: root.is-playing ? "Pause" : "Play";
                            horizontal-stretch: 1;
                            clicked => { root.play-pause-clicked(); }
                        }
                        Button { text: "»"; clicked => { root.seek-forward-clicked(); } }
                    }
                    Text {
                        text: root.mod + "P: play/pause \u{2022} " + (Platform.os == OperatingSystemType.macos ? "\u{2325}" : "Alt+") + "\u{2190}/\u{2192}: 5 s";
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Theme.text-muted;
                    }
                }
            }

            Button {
                text: "Undo changes";
                enabled: !root.busy;
                clicked => { root.undo-clicked(); }
            }
        }

        VerticalLayout {
            spacing: 10px;

            Rectangle {
                vertical-stretch: 1;
                background: Theme.bg-base;
                border-width: 1px;
                border-color: input.has-focus ? Theme.accent : Theme.text-muted.transparentize(0.6);
                border-radius: 4px;

                scroll := ScrollView {
                    input := TextInput {
                        x: 8px;
                        y: 8px;
                        width: scroll.visible-width - 16px;
                        height: max(self.preferred-height, scroll.visible-height - 16px);
                        single-line: false;
                        wrap: word-wrap;
                        read-only: root.busy;
                        color: Theme.text-primary;
                        selection-background-color: Theme.accent.transparentize(0.5);
                        font-size: 14px;
                        text <=> root.text;
                        // Keep the cursor in view while typing / syncing.
                        cursor-position-changed(position) => {
                            if position.y + scroll.content-y < 0 {
                                scroll.content-y = -position.y;
                            } else if position.y + 24px + scroll.content-y > scroll.visible-height {
                                scroll.content-y = scroll.visible-height - position.y - 40px;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.status;
                    vertical-alignment: center;
                    color: Theme.text-muted;
                    overflow: elide;
                }
                Button { text: "Cancel"; clicked => { root.cancel-clicked(); } }
                Button { text: "Apply"; enabled: !root.busy; clicked => { root.apply-clicked(); } }
                Button { text: "OK"; primary: true; enabled: !root.busy; clicked => { root.ok-clicked(); } }
            }
        }
    }
    }
}
