import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { CornerButton } from "vinyl_view.slint";

/// One label/value pair in the Info panel.
export struct InfoRow {
    label: string,
    value: string,
}

/// One line of lyrics (see `app::lyrics`).
export struct LyricLine {
    text: string,
}

/// The current track's tags and technical details (the reference UI's INF
/// tab).
export component InfoView inherits Rectangle {
    in property <[InfoRow]> rows: [];

    background: Theme.bg-base;

    if root.rows.length == 0: Text {
        text: "Nothing playing";
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.rows.length > 0: ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            alignment: start;
            for row in root.rows: HorizontalLayout {
                spacing: 12px;
                Text {
                    width: 110px;
                    text: row.label;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
                Text {
                    horizontal-stretch: 1;
                    text: row.value;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
            }
        }
    }
}

/// Lyrics, centered, with the line being sung highlighted and kept in the
/// middle of the panel (the reference UI's LYR tab). Fed by
/// `app::lyrics::Lyrics`; `status` is shown instead when there are no
/// lines (e.g. "No lyrics found").
/// A button for the lyrics panel: the standard one, or -- on the scroll --
/// one drawn in ink, which reads on parchment.
component LyricsButton inherits Rectangle {
    in property <string> text;
    in property <bool> ink;
    callback clicked();
    width: root.ink ? ink-label.preferred-width + 22px : plain.preferred-width;
    height: root.ink ? 28px : plain.preferred-height;
    plain := Button {
        visible: !root.ink;
        text: root.text;
        clicked => { root.clicked(); }
    }
    Rectangle {
        visible: root.ink;
        border-radius: 4px;
        border-width: 1.5px;
        border-color: #6b4423;
        background: ink-touch.has-hover ? #6b442322 : #f6ead0cc;
        accessible-role: button;
        accessible-label: root.text;
        accessible-action-default => { root.clicked(); }
        ink-label := Text {
            text: root.text;
            font-family: "serif";
            font-italic: true;
            color: #3b2614;
        }
        ink-touch := TouchArea {
            enabled: root.ink;
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component LyricsView inherits Rectangle {
    in property <[LyricLine]> lines: [];
    /// Index into `lines` of the line being sung; -1 for none/unsynced.
    in property <int> active-line: -1;
    /// Synced lyrics keep the sung line in the middle; plain lyrics scroll
    /// along with the song.
    in property <bool> synced: false;
    in property <string> status: "";
    /// Shows "Add lyrics…" / "Edit lyrics…" (a track is playing).
    in property <bool> editable: false;
    /// How far through the song (0 to 1): plain lyrics scroll with it.
    in property <float> progress: 0;
    /// How far through the line being sung (0 to 1), for its underline.
    in property <float> line-progress: 0;
    /// The scroll look: ink on parchment between two wooden rods.
    in property <bool> vintage: false;
    callback edit-clicked();
    callback vintage-toggled();

    property <length> line-height: root.vintage ? 30px : 28px;
    property <length> rod: root.vintage ? 16px : 0px;
    /// Follows the song; scrolling by hand stops that for a while.
    property <bool> following: true;
    property <length> view-height: root.height - 2 * root.rod;
    property <length> top-pad: root.synced ? root.view-height / 2 - root.line-height / 2 : 28px;
    property <length> content: root.lines.length * root.line-height + 2 * root.top-pad;

    property <color> ink: root.vintage ? #3b2614 : Theme.text-primary;
    property <color> faded: root.vintage ? #6b4f33 : Theme.text-muted;
    property <color> mark: root.vintage ? #8b1a10 : Theme.accent;
    property <color> paper: #f3e5c3;

    background: root.vintage ? @linear-gradient(90deg, #cdb07a 0%, #ead7ac 7%, #f6ead0 50%, #ead7ac 93%, #cdb07a 100%) : Theme.bg-base;
    clip: true;

    /// Where the view should be to follow the song.
    function target() -> length {
        if root.synced {
            return root.active-line >= 0 ? -(root.active-line * root.line-height) : 0px;
        }
        return -(Math.max(0px, root.content - root.view-height) * Math.clamp(root.progress, 0, 1));
    }
    function follow() {
        root.following = true;
        flick.content-y = root.target();
    }

    changed active-line => {
        if root.following && root.synced {
            flick.content-y = root.target();
        }
    }
    changed progress => {
        if root.following && !root.synced && Math.abs(flick.content-y - root.target()) > 1px {
            flick.content-y = root.target();
        }
    }
    init => { root.follow(); }
    changed lines => { root.follow(); }
    changed synced => { root.follow(); }

    resume := Timer {
        interval: 6s;
        running: false;
        triggered => {
            self.running = false;
            root.follow();
        }
    }

    if root.lines.length == 0: VerticalLayout {
        y: root.rod;
        height: root.view-height;
        alignment: center;
        spacing: 10px;
        padding: 12px;
        Text {
            text: root.status;
            color: root.faded;
            font-italic: root.vintage;
            font-family: root.vintage ? "serif" : "";
            font-size: root.vintage ? 16px : 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.editable: HorizontalLayout {
            alignment: center;
            LyricsButton { text: "Add lyrics…"; ink: root.vintage; clicked => { root.edit-clicked(); } }
        }
    }

    flick := Flickable {
        y: root.rod;
        height: root.view-height;
        visible: root.lines.length > 0;
        content-height: root.content;
        animate content-y { duration: 320ms; easing: ease-out; }
        flicked => {
            root.following = false;
            resume.running = false;
            resume.running = true;
        }

        // The line being sung: a soft band behind it, and an underline
        // filling as it's sung.
        if root.synced && root.active-line >= 0: Rectangle {
            x: (root.width - self.width) / 2;
            y: root.top-pad + root.active-line * root.line-height;
            width: Math.min(root.width - 16px, 420px);
            height: root.line-height;
            border-radius: root.vintage ? 0px : 8px;
            background: root.vintage ? transparent : Theme.accent.transparentize(0.86);
            animate y { duration: 320ms; easing: ease-out; }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - 4px;
                width: parent.width * 0.7;
                height: 2px;
                border-radius: 1px;
                background: root.mark.transparentize(0.8);
                Rectangle {
                    x: 0;
                    width: parent.width * Math.clamp(root.line-progress, 0, 1);
                    border-radius: 1px;
                    background: root.mark;
                }
            }
        }

        for line[i] in root.lines: Text {
            property <int> distance: Math.abs(i - root.active-line);
            property <bool> sung: i == root.active-line;
            x: 12px;
            y: root.top-pad + i * root.line-height;
            width: root.width - 24px;
            height: root.line-height;
            text: line.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            font-family: root.vintage ? "serif" : "";
            font-italic: root.vintage && !self.sung;
            font-size: self.sung ? (root.vintage ? 19px : 17px) : (root.vintage ? 16px : 14px);
            font-weight: self.sung ? 700 : 400;
            color: self.sung ? (root.vintage ? root.mark : root.ink) : root.faded;
            // Synced: lines fade with their distance from the one sung.
            opacity: root.synced && root.active-line >= 0 ? Math.max(0.3, 1 - self.distance * 0.17) : 1;
            animate font-size, opacity, color { duration: 220ms; easing: ease-out; }
        }
    }

    // Soft edges, top and bottom, so lines fade in and out of view.
    Rectangle {
        y: root.rod;
        height: 28px;
        background: @linear-gradient(180deg, (root.vintage ? root.paper : Theme.bg-base) 0%, (root.vintage ? root.paper : Theme.bg-base).transparentize(1) 100%);
    }
    Rectangle {
        y: root.height - root.rod - self.height;
        height: 28px;
        background: @linear-gradient(0deg, (root.vintage ? root.paper : Theme.bg-base) 0%, (root.vintage ? root.paper : Theme.bg-base).transparentize(1) 100%);
    }

    // The scroll's wooden rods, a shadow cast on the paper by the top one.
    if root.vintage: Rectangle {
        y: root.rod;
        height: 10px;
        background: @linear-gradient(180deg, #00000040 0%, #00000000 100%);
    }
    if root.vintage: Rectangle {
        y: root.height - root.rod - self.height;
        height: 8px;
        background: @linear-gradient(0deg, #00000030 0%, #00000000 100%);
    }
    for top[k] in (root.vintage ? [true, false] : []): Rectangle {
        y: top ? 0px : root.height - root.rod;
        height: root.rod;
        Rectangle {
            x: 10px;
            width: parent.width - 20px;
            border-radius: self.height / 2;
            background: @linear-gradient(180deg, #4a2c14 0%, #a8743f 40%, #7a4f27 70%, #3b2210 100%);
        }
        for side in [0, 1]: Rectangle {
            x: side == 0 ? 2px : parent.width - self.width - 2px;
            width: 14px;
            border-radius: 7px;
            background: @radial-gradient(circle, #c99a5a 0%, #6b4423 70%, #3b2210 100%);
        }
    }

    // Scrolled away by hand: back to following the song.
    if !root.following && root.lines.length > 0: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - root.rod - self.height - 10px;
        width: follow-text.preferred-width + 24px;
        height: 26px;
        border-radius: 13px;
        background: root.vintage ? #6b4423 : Theme.accent;
        accessible-role: button;
        accessible-label: "Follow the song";
        accessible-action-default => { root.follow(); }
        follow-text := Text {
            text: "Follow the song";
            font-size: 12px;
            color: root.vintage ? #f6ead0 : Theme.accent-text;
            vertical-alignment: center;
        }
        TouchArea {
            mouse-cursor: pointer;
            clicked => { root.follow(); }
        }
    }

    CornerButton {
        x: 6px;
        y: root.rod + 4px;
        icon: @image-url("assets/icons/scroll.svg");
        label: "Scroll look";
        active: root.vintage;
        clicked => { root.vintage-toggled(); }
    }
    if root.editable && root.lines.length > 0: LyricsButton {
        x: parent.width - self.width - 10px;
        y: root.rod + 8px;
        text: "Edit lyrics…";
        ink: root.vintage;
        clicked => { root.edit-clicked(); }
    }
}

/// A panel whose feature doesn't exist yet (BIO, LIB).
export component PlaceholderView inherits Rectangle {
    in property <string> title;
    in property <string> message;

    background: Theme.bg-base;

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding: 24px;
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.message;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

/// A tab group's buttons (the reference UI's "INF BIO LYR ART LIB" strip).
export component TabStripView inherits Rectangle {
    in property <[string]> labels: [];
    in property <int> active: 0;
    // Positions are relative to the strip. Clicking vs dragging is decided
    // by the app (a release without a drag is a click).
    callback tab-pressed(int, length, length);
    callback tab-moved(length, length);
    callback tab-released();

    // Tabs share the width, as an editor's do: no wider than `max-tab`
    // (the rest of a wide strip stays empty), down to `min-tab` each; with
    // less room than that the strip scrolls (the wheel, or the arrows at its
    // ends).
    property <length> min-tab: 52px;
    property <length> max-tab: 96px;
    property <int> count: Math.max(1, root.labels.length);
    property <length> tab-width: Math.clamp(root.width / root.count, root.min-tab, root.max-tab);
    property <length> content-width: root.tab-width * root.count;
    property <bool> overflowing: root.content-width > root.width + 0.5px;
    property <length> min-offset: Math.min(0px, root.width - root.content-width);
    /// How far the tabs are scrolled (0 or less).
    property <length> offset: 0px;
    property <length> arrow: 18px;

    background: Theme.bg-raised;
    clip: true;
    // Not cached (`cache-rendering-hint`): on the GPU renderer a cached
    // strip could keep drawing at its old, wider size after its panel was
    // made narrower -- over the panel beside it. It's a few tabs; drawing
    // them is cheap.

    function scroll-to(offset: length) {
        root.offset = Math.clamp(offset, root.min-offset, 0px);
    }
    /// The active tab in view, clear of the arrows.
    function show-active() {
        if !root.overflowing {
            root.offset = 0px;
            return;
        }
        let left = root.active * root.tab-width;
        if left + root.offset < root.arrow {
            root.scroll-to(root.arrow - left);
        } else if left + root.tab-width + root.offset > root.width - root.arrow {
            root.scroll-to(root.width - root.arrow - left - root.tab-width);
        }
    }
    /// A point on the tabs (`x` along all of them) as the app takes it:
    /// within the strip, as if the tabs shared all its width (how it tells
    /// where a dragged tab goes -- past the last tab is after it); outside
    /// it, where it is.
    function reported-x(x: length, y: length) -> length {
        let seen = x + root.offset;
        if seen >= 0 && seen < root.width && y >= 0 && y < root.height {
            return Math.min(x / root.content-width * root.width, root.width - 1px);
        }
        return seen;
    }
    init => { root.show-active(); }
    changed active => { root.show-active(); }
    changed width => { root.show-active(); }
    changed labels => { root.show-active(); }

    wheel := TouchArea {
        scroll-event(event) => {
            if !root.overflowing {
                return reject;
            }
            root.scroll-to(root.offset + (Math.abs(event.delta-x) > Math.abs(event.delta-y) ? event.delta-x : event.delta-y));
            return accept;
        }

        for label[i] in root.labels: Rectangle {
            x: root.offset + i * root.tab-width;
            width: root.tab-width;
            background: i == root.active ? Theme.bg-sunken : touch.has-hover ? Theme.bg-base : transparent;
            border-width: 0px;
            touch := TouchArea {
                mouse-cursor: pointer;
                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        root.tab-pressed(i, root.reported-x(i * root.tab-width + self.mouse-x, self.mouse-y), self.mouse-y);
                    } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                        root.tab-released();
                    }
                }
                moved => { root.tab-moved(root.reported-x(i * root.tab-width + self.mouse-x, self.mouse-y), self.mouse-y); }
            }
            Text {
                x: 4px;
                width: parent.width - 8px;
                text: label;
                font-weight: 700;
                font-size: 12px;
                color: i == root.active ? Theme.text-primary : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            // The tab showing: an accent bar under it, which every theme
            // shows clearly (its background alone can be near the strip's).
            if i == root.active: Rectangle {
                x: 6px;
                y: parent.height - self.height;
                width: parent.width - 12px;
                height: 2px;
                border-radius: 1px;
                background: Theme.accent;
            }
            // Separator to the next tab.
            if i + 1 < root.labels.length: Rectangle {
                x: parent.width - 1px;
                y: 4px;
                width: 1px;
                height: parent.height - 8px;
                background: Theme.text-muted.transparentize(0.75);
            }
        }
    }

    // More tabs to one side: an arrow there scrolls to them.
    for side[k] in (root.overflowing ? [-1, 1] : []): Rectangle {
        property <bool> more: side < 0 ? root.offset < 0px : root.offset > root.min-offset;
        visible: self.more;
        x: side < 0 ? 0px : root.width - self.width;
        width: root.arrow;
        background: side < 0
            ? @linear-gradient(90deg, Theme.bg-raised 60%, Theme.bg-raised.transparentize(1) 100%)
            : @linear-gradient(270deg, Theme.bg-raised 60%, Theme.bg-raised.transparentize(1) 100%);
        accessible-role: button;
        accessible-label: side < 0 ? "Earlier tabs" : "Later tabs";
        accessible-action-default => { root.scroll-to(root.offset - side * root.tab-width); }
        Text {
            text: side < 0 ? "\u{2039}" : "\u{203a}";
            font-size: 16px;
            color: arrow-touch.has-hover ? Theme.text-primary : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        arrow-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.scroll-to(root.offset - side * root.tab-width); }
        }
    }
}

/// One of several artists sharing a name, offered in `ArtistView`.
export struct ArtistCandidate {
    name: string,
    detail: string,
}

/// Artist information (the reference UI's BIO tab), from MusicBrainz and
/// optionally Wikipedia via `app::artist_info`. Looked up only when the
/// user clicks the button.
export component ArtistView inherits Rectangle {
    /// "nothing", "idle", "loading", "choose", "found", "not-found" or
    /// "error".
    in property <string> state: "nothing";
    /// Namesakes to choose from in the "choose" state.
    in property <[ArtistCandidate]> candidates: [];
    callback candidate-clicked(int);
    callback none-of-these-clicked();
    in property <string> artist;
    in property <string> meta;
    in property <string> genres;
    in property <string> summary;
    in property <image> photo;
    in property <bool> has-photo: false;
    in property <string> link-label;
    in property <string> credit;
    /// Idle: what clicking sends where. Not found / error: what happened.
    in property <string> message;
    callback lookup-clicked();
    callback link-clicked();

    background: Theme.bg-base;

    if root.state == "nothing": Text {
        text: "Nothing playing";
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.state == "idle" || root.state == "loading" || root.state == "not-found" || root.state == "error": VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 10px;
        Text {
            text: root.artist;
            font-size: 18px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.state == "loading" ? "Looking up artist information…" : root.message;
            color: root.state == "error" ? Theme.accent : Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        // Looking it up, or -- only when that failed (no connection, the
        // service down) -- trying again.
        if root.state == "idle" || root.state == "error": HorizontalLayout {
            alignment: center;
            Button {
                text: root.state == "idle" ? "Look up artist online" : "Reload";
                clicked => { root.lookup-clicked(); }
            }
        }
    }

    if root.state == "choose": choose-scroll := ScrollView {
        VerticalLayout {
            // As wide as the panel, so the text wraps instead of running
            // off its side.
            width: choose-scroll.visible-width;
            padding: 16px;
            spacing: 6px;
            alignment: start;
            Text { text: root.artist; font-size: 18px; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
            Text {
                text: "Several artists have this name. Which one is it?";
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            Rectangle { height: 4px; }
            for candidate[i] in root.candidates: Rectangle {
                height: 44px;
                border-radius: 4px;
                background: pick.has-hover ? Theme.bg-raised : Theme.bg-sunken;
                pick := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.candidate-clicked(i); }
                }
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    Text { text: candidate.name; font-weight: 700; color: Theme.text-primary; overflow: elide; }
                    if candidate.detail != "": Text {
                        text: candidate.detail;
                        font-size: 11px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                Button {
                    text: "None of these";
                    clicked => { root.none-of-these-clicked(); }
                }
            }
            Text {
                text: "Your choice is remembered for this artist name.";
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }

    if root.state == "found": found-scroll := ScrollView {
        VerticalLayout {
            // As wide as the panel, so the text wraps instead of running
            // off its side.
            width: found-scroll.visible-width;
            padding: 16px;
            spacing: 12px;
            alignment: start;
            // Wide: the photo beside the name. Narrow: above it, smaller.
            if found-scroll.visible-width >= 320px: HorizontalLayout {
                spacing: 14px;
                if root.has-photo: Image {
                    source: root.photo;
                    width: 120px;
                    height: 120px;
                    image-fit: cover;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text { text: root.artist; font-size: 20px; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                    if root.meta != "": Text { text: root.meta; color: Theme.text-muted; wrap: word-wrap; }
                    if root.genres != "": Text { text: root.genres; color: Theme.accent; wrap: word-wrap; }
                }
            }
            if found-scroll.visible-width < 320px: VerticalLayout {
                spacing: 6px;
                if root.has-photo: HorizontalLayout {
                    alignment: center;
                    Image {
                        source: root.photo;
                        width: Math.min(120px, found-scroll.visible-width - 32px);
                        height: self.width;
                        image-fit: cover;
                    }
                }
                Text { text: root.artist; font-size: 18px; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; horizontal-alignment: center; }
                if root.meta != "": Text { text: root.meta; color: Theme.text-muted; wrap: word-wrap; horizontal-alignment: center; }
                if root.genres != "": Text { text: root.genres; color: Theme.accent; wrap: word-wrap; horizontal-alignment: center; }
            }
            if root.summary != "": Text {
                text: root.summary;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            link := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.link-clicked(); }
                Text {
                    width: parent.width;
                    text: root.link-label;
                    color: link.has-hover ? Theme.text-primary : Theme.accent;
                    wrap: word-wrap;
                }
            }
            Text {
                text: root.credit;
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
}
