import { Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

/// One label/value pair in the Info panel.
export struct InfoRow {
    label: string,
    value: string,
}

/// One line of lyrics (see `app::lyrics`).
export struct LyricLine {
    text: string,
}

/// The current track's tags and technical details (the reference UI's INF
/// tab).
export component InfoView inherits Rectangle {
    in property <[InfoRow]> rows: [];

    background: Theme.bg-base;

    if root.rows.length == 0: Text {
        text: "Nothing playing";
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.rows.length > 0: ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            alignment: start;
            for row in root.rows: HorizontalLayout {
                spacing: 12px;
                Text {
                    width: 110px;
                    text: row.label;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                }
                Text {
                    horizontal-stretch: 1;
                    text: row.value;
                    color: Theme.text-primary;
                    wrap: word-wrap;
                }
            }
        }
    }
}

/// Lyrics, centered, with the line being sung highlighted and kept in the
/// middle of the panel (the reference UI's LYR tab). Fed by
/// `app::lyrics::Lyrics`; `status` is shown instead when there are no
/// lines (e.g. "No lyrics found").
export component LyricsView inherits Rectangle {
    in property <[LyricLine]> lines: [];
    /// Index into `lines` of the line being sung; -1 for none/unsynced.
    in property <int> active-line: -1;
    /// Synced lyrics keep the sung line in the middle; plain lyrics read
    /// from the top.
    in property <bool> synced: false;
    in property <string> status: "";
    /// Shows "Add lyrics…" / "Edit lyrics…" (a track is playing).
    in property <bool> editable: false;
    callback edit-clicked();

    property <length> line-height: 22px;

    background: Theme.bg-base;
    clip: true;

    if root.lines.length == 0: VerticalLayout {
        alignment: center;
        spacing: 10px;
        Text {
            text: root.status;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.editable: HorizontalLayout {
            alignment: center;
            Button { text: "Add lyrics…"; clicked => { root.edit-clicked(); } }
        }
    }
    if root.lines.length > 0: flick := Flickable {
        // Plain lyrics: the lines plus a margin, so scrolling stops at the
        // last line. Synced: enough room above and below for the first and
        // last line to sit in the middle -- no more.
        content-height: root.synced
            ? root.lines.length * root.line-height + self.height - root.line-height
            : root.lines.length * root.line-height + 32px;
        // Synced: keep the active line centered; unsynced: free scrolling
        // starting at the top.
        content-y: root.active-line >= 0
            ? -(root.active-line * root.line-height)
            : 0;
        animate content-y { duration: 250ms; easing: ease-out; }

        for line[i] in root.lines: Text {
            x: 0;
            y: (root.synced ? root.height / 2 - root.line-height / 2 : 16px) + i * root.line-height;
            width: root.width;
            height: root.line-height;
            text: line.text;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: i == root.active-line ? Theme.text-primary : Theme.text-muted;
            font-weight: i == root.active-line ? 700 : 400;
        }
    }
    if root.editable && root.lines.length > 0: Button {
        x: parent.width - self.width - 10px;
        y: 10px;
        text: "Edit lyrics…";
        clicked => { root.edit-clicked(); }
    }
}

/// A panel whose feature doesn't exist yet (BIO, LIB).
export component PlaceholderView inherits Rectangle {
    in property <string> title;
    in property <string> message;

    background: Theme.bg-base;

    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding: 24px;
        Text {
            text: root.title;
            color: Theme.text-primary;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.message;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

/// A tab group's buttons (the reference UI's "INF BIO LYR ART LIB" strip).
export component TabStripView inherits Rectangle {
    in property <[string]> labels: [];
    in property <int> active: 0;
    // Positions are relative to the strip. Clicking vs dragging is decided
    // by the app (a release without a drag is a click).
    callback tab-pressed(int, length, length);
    callback tab-moved(length, length);
    callback tab-released();

    background: Theme.bg-raised;

    for label[i] in root.labels: Rectangle {
        x: i * root.width / Math.max(1, root.labels.length);
        width: root.width / Math.max(1, root.labels.length);
        background: i == root.active ? Theme.bg-sunken : touch.has-hover ? Theme.bg-base : transparent;
        border-width: 0px;
        touch := TouchArea {
            mouse-cursor: pointer;
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    root.tab-pressed(i, parent.x + self.mouse-x, self.mouse-y);
                } else if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                    root.tab-released();
                }
            }
            moved => { root.tab-moved(parent.x + self.mouse-x, self.mouse-y); }
        }
        Text {
            text: label;
            font-weight: 700;
            font-size: 12px;
            color: i == root.active ? Theme.text-primary : Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // Separator to the next tab.
        if i + 1 < root.labels.length: Rectangle {
            x: parent.width - 1px;
            y: 4px;
            width: 1px;
            height: parent.height - 8px;
            background: Theme.text-muted.transparentize(0.75);
        }
    }
}

/// One of several artists sharing a name, offered in `ArtistView`.
export struct ArtistCandidate {
    name: string,
    detail: string,
}

/// Artist information (the reference UI's BIO tab), from MusicBrainz and
/// optionally Wikipedia via `app::artist_info`. Looked up only when the
/// user clicks the button.
export component ArtistView inherits Rectangle {
    /// "nothing", "idle", "loading", "choose", "found", "not-found" or
    /// "error".
    in property <string> state: "nothing";
    /// Namesakes to choose from in the "choose" state.
    in property <[ArtistCandidate]> candidates: [];
    callback candidate-clicked(int);
    callback none-of-these-clicked();
    in property <string> artist;
    in property <string> meta;
    in property <string> genres;
    in property <string> summary;
    in property <image> photo;
    in property <bool> has-photo: false;
    in property <string> link-label;
    in property <string> credit;
    /// Idle: what clicking sends where. Not found / error: what happened.
    in property <string> message;
    callback lookup-clicked();
    callback link-clicked();

    background: Theme.bg-base;

    if root.state == "nothing": Text {
        text: "Nothing playing";
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.state == "idle" || root.state == "loading" || root.state == "not-found" || root.state == "error": VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 10px;
        Text {
            text: root.artist;
            font-size: 18px;
            font-weight: 700;
            color: Theme.text-primary;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: root.state == "loading" ? "Looking up artist information…" : root.message;
            color: root.state == "error" ? Theme.accent : Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.state != "loading": HorizontalLayout {
            alignment: center;
            Button {
                text: root.state == "idle" ? "Look up artist online" : "Look up again";
                clicked => { root.lookup-clicked(); }
            }
        }
    }

    if root.state == "choose": ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 6px;
            alignment: start;
            Text { text: root.artist; font-size: 18px; font-weight: 700; color: Theme.text-primary; }
            Text {
                text: "Several artists have this name. Which one is it?";
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            Rectangle { height: 4px; }
            for candidate[i] in root.candidates: Rectangle {
                height: 44px;
                border-radius: 4px;
                background: pick.has-hover ? Theme.bg-raised : Theme.bg-sunken;
                pick := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.candidate-clicked(i); }
                }
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: center;
                    Text { text: candidate.name; font-weight: 700; color: Theme.text-primary; }
                    if candidate.detail != "": Text {
                        text: candidate.detail;
                        font-size: 11px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                Button {
                    text: "None of these";
                    clicked => { root.none-of-these-clicked(); }
                }
            }
            Text {
                text: "Your choice is remembered for this artist name.";
                font-size: 10px;
                color: Theme.text-muted;
            }
        }
    }

    if root.state == "found": ScrollView {
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;
            HorizontalLayout {
                spacing: 14px;
                if root.has-photo: Image {
                    source: root.photo;
                    width: 120px;
                    height: 120px;
                    image-fit: cover;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text { text: root.artist; font-size: 20px; font-weight: 700; color: Theme.text-primary; wrap: word-wrap; }
                    if root.meta != "": Text { text: root.meta; color: Theme.text-muted; }
                    if root.genres != "": Text { text: root.genres; color: Theme.accent; wrap: word-wrap; }
                }
            }
            if root.summary != "": Text {
                text: root.summary;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 12px;
                link := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.link-clicked(); }
                    Text {
                        text: root.link-label;
                        color: link.has-hover ? Theme.text-primary : Theme.accent;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: "Look up again";
                    clicked => { root.lookup-clicked(); }
                }
            }
            Text {
                text: root.credit;
                font-size: 10px;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
}
