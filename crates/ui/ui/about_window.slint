import { Button } from "std-widgets.slint";

export component AboutWindow inherits Window {
    title: "About Openbar5000";
    preferred-width: 380px;
    preferred-height: 220px;
    background: #202020;

    callback close-clicked();

    VerticalLayout {
        padding: 18px;
        spacing: 10px;

        Text { text: "Openbar5000"; font-size: 20px; font-weight: 700; color: white; }
        Text {
            text: "An open-source, cross-platform alternative to foobar2000.";
            color: #cfcfcf;
            wrap: word-wrap;
        }
        Text { text: "Built with Rust and Slint."; color: #cfcfcf; }
        Text {
            text: "UI powered by Slint (https://slint.dev), used under its Royalty-free license.";
            color: #9a9a9a;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            Button { text: "Close"; clicked => { root.close-clicked(); } }
        }
    }
}
