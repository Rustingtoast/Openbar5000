import { AboutSlint, Button, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component AboutWindow inherits Window {
    title: "About Openbar5000";
    icon: Theme.logo;
    preferred-width: 380px;
    preferred-height: 350px;
    background: Theme.bg-raised;

    in property <bool> theme-is-dark: true;
    init => {
        Palette.color-scheme = root.theme-is-dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed theme-is-dark => {
        Palette.color-scheme = root.theme-is-dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Set from Cargo.toml's version at startup (see `app::wiring`).
    in property <string> app-version;
    callback close-clicked();

    VerticalLayout {
        padding: 18px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 14px;
            Image {
                source: Theme.logo;
                width: 56px;
                height: 56px;
            }
            VerticalLayout {
                alignment: center;
                Text { text: "Openbar5000"; font-size: 20px; font-weight: 700; color: Theme.text-primary; }
                Text { text: "Version " + root.app-version; color: Theme.text-muted; }
                Text {
                    text: "An open-source, cross-platform music player.";
                    color: Theme.text-muted;
                    wrap: word-wrap;
                }
            }
        }
        Text { text: "Built with Rust and Slint."; color: Theme.text-muted; }
        // Slint's Royalty-free license asks for this in the About dialog.
        AboutSlint { }
        Text {
            text: "UI powered by Slint (https://slint.dev), used under its Royalty-free license.";
            color: Theme.text-muted;
            font-size: 11px;
            wrap: word-wrap;
        }

        Rectangle { vertical-stretch: 1; }

        HorizontalLayout {
            alignment: end;
            Button { text: "Close"; clicked => { root.close-clicked(); } }
        }
    }
}
