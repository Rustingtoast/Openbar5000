import { Theme } from "theme.slint";
import { Spinner } from "spinner.slint";

/// One line describing the current track (issue #10):
/// "01. Title (6:43) • Artist • Album".
export component NowPlayingBar inherits Rectangle {
    in property <string> text;

    height: 28px;
    background: Theme.bg-raised;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Image {
            source: Theme.logo;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text == "" ? "Not playing" : root.text;
            color: root.text == "" ? Theme.text-muted : Theme.text-primary;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

/// The current track's cover art, scaled to fit (issue #10).
export component AlbumArtView inherits Rectangle {
    in property <image> art;
    in property <bool> has-art: false;
    /// The cover is being read: a spinner instead of the "no art" disc.
    in property <bool> loading: false;

    background: Theme.bg-sunken;

    if root.has-art: Image {
        x: 4px;
        y: 4px;
        width: parent.width - 8px;
        height: parent.height - 8px;
        source: root.art;
        image-fit: contain;
    }
    // No embedded art: a plain grey disc.
    if !root.has-art && !root.loading: Image {
        width: min(parent.width, parent.height) * 0.45;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("assets/icons/disc.svg");
        colorize: Theme.text-muted;
    }
    Spinner {
        width: Math.min(48px, Math.min(parent.width, parent.height) * 0.3);
        height: self.width;
        active: root.loading;
    }
}
