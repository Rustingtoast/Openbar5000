import { ListView } from "std-widgets.slint";

export struct PlaylistRow {
    track-number: string,
    artist: string,
    title: string,
    album: string,
    duration: string,
}

export component PlaylistView inherits Rectangle {
    in property <[PlaylistRow]> rows: [];
    in property <int> current-index: -1;
    callback row-clicked(int);

    background: white;

    VerticalLayout {
        Rectangle {
            height: 24px;
            background: #dddddd;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                Text { text: "#"; width: 36px; vertical-alignment: center; font-weight: 600; }
                Text { text: "Artist"; width: 160px; vertical-alignment: center; font-weight: 600; }
                Text { text: "Title"; horizontal-stretch: 1; vertical-alignment: center; font-weight: 600; }
                Text { text: "Album"; width: 160px; vertical-alignment: center; font-weight: 600; }
                Text { text: "Duration"; width: 70px; vertical-alignment: center; font-weight: 600; }
            }
        }
        ListView {
            vertical-stretch: 1;
            for row[i] in root.rows: Rectangle {
                height: 22px;
                background: i == root.current-index ? #3366cc : transparent;
                TouchArea {
                    clicked => { root.row-clicked(i); }
                    HorizontalLayout {
                        padding: 4px;
                        spacing: 4px;
                        Text { text: row.track-number; width: 36px; vertical-alignment: center; color: i == root.current-index ? white : black; }
                        Text { text: row.artist; width: 160px; vertical-alignment: center; color: i == root.current-index ? white : black; overflow: elide; }
                        Text { text: row.title; horizontal-stretch: 1; vertical-alignment: center; color: i == root.current-index ? white : black; overflow: elide; }
                        Text { text: row.album; width: 160px; vertical-alignment: center; color: i == root.current-index ? white : black; overflow: elide; }
                        Text { text: row.duration; width: 70px; vertical-alignment: center; color: i == root.current-index ? white : black; }
                    }
                }
            }
        }
    }
}
