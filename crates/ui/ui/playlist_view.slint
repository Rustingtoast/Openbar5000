import { ListView, LineEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";

export struct PlaylistRow {
    is-header: bool,
    cover-image: image,
    // False when the group's first track has no embedded art: a grey disc
    // icon is shown instead of `cover-image`.
    has-cover: bool,
    group-title: string,
    group-subtitle: string,
    group-info: string,
    group-date: string,
    // Grouping key shared by a header and its tracks -- what
    // Collapse/Expand targets.
    group-key: string,
    is-collapsed: bool,
    track-number: string,
    title: string,
    // Shown in list view only (album view has them in the header).
    artist: string,
    album: string,
    duration: string,
    track-index: int,
    is-current: bool,
}

export component PlaylistView inherits Rectangle {
    in property <[PlaylistRow]> rows: [];
    /// Shown above the list, e.g. "23 tracks, Length: 1:21:07".
    in property <string> summary: "";
    // Active Grouping submenu id (see `PlaylistGrouping::as_str`), for the
    // submenu's check mark.
    in property <string> grouping: "artist-album-disc";
    /// List view (Preferences > Appearance): one plain row per song, with
    /// artist and album columns and no album headers.
    in property <bool> list-view: false;
    callback row-clicked(int);
    callback row-properties-clicked(int);
    callback row-open-folder-clicked(int);
    callback row-remove-clicked(int);
    callback row-cut-clicked(int);
    callback row-copy-clicked(int);
    callback row-enqueue-clicked(int);
    callback group-toggle-clicked(string);
    callback collapse-all-clicked();
    callback expand-all-clicked();
    callback grouping-clicked(string);
    callback sort-clicked(string);
    callback show-now-playing-clicked();
    callback refresh-playlist-clicked();
    callback search-edited(string);

    // `scroll-to(scroll-y)` runs whenever `scroll-serial` changes -- how the
    // main window reaches this view inside a panel slot.
    in property <int> scroll-serial: 0;
    in property <length> scroll-y: 0;
    changed scroll-serial => { root.scroll-to(root.scroll-y); }

    // Scrolls so content offset `y` (from the top of the list) sits a
    // third of the way down the visible area.
    public function scroll-to(y: length) {
        list.content-y = max(min(0px, -(y - list.visible-height / 3)), list.visible-height - list.content-height);
    }

    background: Theme.bg-base;

    VerticalLayout {
        // Summary line on top, search box at the bottom, as in the
        // reference UI.
        Rectangle {
            height: 18px;
            background: Theme.bg-raised;
            Text {
                text: root.summary;
                font-size: 11px;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.list-view: Rectangle {
            height: 20px;
            background: Theme.bg-raised;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 8px;
                Text { text: "#"; width: 34px; font-size: 11px; vertical-alignment: center; color: Theme.text-muted; }
                Text { text: "Title"; horizontal-stretch: 3; min-width: 0; preferred-width: 0; font-size: 11px; vertical-alignment: center; color: Theme.text-muted; }
                Text { text: "Artist"; horizontal-stretch: 2; min-width: 0; preferred-width: 0; font-size: 11px; vertical-alignment: center; color: Theme.text-muted; }
                Text { text: "Album"; horizontal-stretch: 2; min-width: 0; preferred-width: 0; font-size: 11px; vertical-alignment: center; color: Theme.text-muted; }
                Text { text: "Length"; width: 52px; font-size: 11px; vertical-alignment: center; color: Theme.text-muted; }
            }
        }

        list := ListView {
            vertical-stretch: 1;
            for row[i] in root.rows: Rectangle {
                height: row.is-header ? 64px : 22px;
                background: row.is-current ? Theme.accent : transparent;

                // One menu for both row kinds, mirroring the reference UI's
                // playlist context menu; track-only entries are hidden on
                // group headers, where they'd be ambiguous.
                ContextMenuArea {
                    Menu {
                        MenuItem { title: "Show now playing"; activated => { root.show-now-playing-clicked(); } }
                        MenuItem { title: "Refresh playlist"; activated => { root.refresh-playlist-clicked(); } }
                        MenuSeparator {}
                        if !row.is-header: MenuItem { title: "Cut"; activated => { root.row-cut-clicked(row.track-index); } }
                        if !row.is-header: MenuItem { title: "Copy"; activated => { root.row-copy-clicked(row.track-index); } }
                        if !row.is-header: MenuSeparator {}
                        if !row.is-header: MenuItem { title: "Remove"; activated => { root.row-remove-clicked(row.track-index); } }
                        if !row.is-header: MenuSeparator {}
                        if !root.list-view: Menu {
                            title: "Collapse/Expand";
                            MenuItem {
                                title: row.is-collapsed ? "Expand this group" : "Collapse this group";
                                activated => { root.group-toggle-clicked(row.group-key); }
                            }
                            MenuSeparator {}
                            MenuItem { title: "Collapse all"; activated => { root.collapse-all-clicked(); } }
                            MenuItem { title: "Expand all"; activated => { root.expand-all-clicked(); } }
                        }
                        if !root.list-view: Menu {
                            title: "Grouping";
                            MenuItem { title: "Reset to default"; activated => { root.grouping-clicked("artist-album-disc"); } }
                            MenuSeparator {}
                            MenuItem { title: "by artist"; checkable: true; checked: root.grouping == "artist"; activated => { root.grouping-clicked("artist"); } }
                            MenuItem { title: "by artist / album"; checkable: true; checked: root.grouping == "artist-album"; activated => { root.grouping-clicked("artist-album"); } }
                            MenuItem { title: "by artist / album / disc number [default]"; checkable: true; checked: root.grouping == "artist-album-disc"; activated => { root.grouping-clicked("artist-album-disc"); } }
                            MenuItem { title: "by path"; checkable: true; checked: root.grouping == "path"; activated => { root.grouping-clicked("path"); } }
                            MenuItem { title: "by date"; checkable: true; checked: root.grouping == "date"; activated => { root.grouping-clicked("date"); } }
                        }
                        Menu {
                            title: "Sort";
                            MenuItem { title: "by album"; activated => { root.sort-clicked("album"); } }
                            MenuItem { title: "by artist"; activated => { root.sort-clicked("artist"); } }
                            MenuItem { title: "by file path"; activated => { root.sort-clicked("path"); } }
                            MenuItem { title: "by title"; activated => { root.sort-clicked("title"); } }
                            MenuItem { title: "by track number"; activated => { root.sort-clicked("track-number"); } }
                            MenuItem { title: "by date"; activated => { root.sort-clicked("date"); } }
                            MenuSeparator {}
                            MenuItem { title: "Randomize"; activated => { root.sort-clicked("randomize"); } }
                            MenuItem { title: "Reverse"; activated => { root.sort-clicked("reverse"); } }
                        }
                        MenuSeparator {}
                        if !row.is-header: MenuItem { title: "Add to playback queue"; activated => { root.row-enqueue-clicked(row.track-index); } }
                        MenuItem { title: "Play"; activated => { root.row-clicked(row.track-index); } }
                        MenuItem { title: "Open containing folder"; activated => { root.row-open-folder-clicked(row.track-index); } }
                        if !row.is-header: MenuSeparator {}
                        if !row.is-header: MenuItem { title: "Properties"; activated => { root.row-properties-clicked(row.track-index); } }
                    }

                    if row.is-header: TouchArea {
                        clicked => { root.group-toggle-clicked(row.group-key); }
                        HorizontalLayout {
                            padding: 8px;
                            spacing: 10px;
                            Text {
                                text: row.is-collapsed ? "\u{25b8}" : "\u{25be}";
                                width: 10px;
                                vertical-alignment: center;
                                color: row.is-current ? Theme.accent-text : Theme.text-muted;
                            }
                            if row.has-cover: Image {
                                source: row.cover-image;
                                width: 48px;
                                height: 48px;
                            }
                            if !row.has-cover: Rectangle {
                                width: 48px;
                                height: 48px;
                                background: Theme.bg-sunken;
                                Image {
                                    source: @image-url("assets/icons/disc.svg");
                                    width: 28px;
                                    height: 28px;
                                    colorize: Theme.text-muted;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: row.group-title; font-size: 15px; font-weight: 700; color: row.is-current ? Theme.accent-text : Theme.text-primary; overflow: elide; }
                                // Album, then a thin rule running across to
                                // the date.
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: row.group-subtitle; font-size: 12px; color: row.is-current ? Theme.accent-text : Theme.accent; overflow: elide; }
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 16px;
                                        Rectangle {
                                            y: (parent.height - self.height) / 2;
                                            height: 1px;
                                            background: row.is-current ? Theme.accent-text.transparentize(0.6) : Theme.text-muted.transparentize(0.7);
                                        }
                                    }
                                    Text {
                                        text: row.group-date;
                                        font-size: 12px;
                                        color: row.is-current ? Theme.accent-text : Theme.text-muted;
                                    }
                                }
                                Text { text: row.group-info; font-size: 10px; color: row.is-current ? Theme.accent-text : Theme.text-muted; overflow: elide; }
                            }
                        }
                    }

                    if !row.is-header: TouchArea {
                        clicked => { root.row-clicked(row.track-index); }
                        if root.list-view: HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 4px;
                            spacing: 8px;
                            Text { text: row.track-number; width: 34px; vertical-alignment: center; color: row.is-current ? Theme.accent-text : Theme.text-muted; }
                            Text { text: row.title; horizontal-stretch: 3; min-width: 0; preferred-width: 0; vertical-alignment: center; color: row.is-current ? Theme.accent-text : Theme.text-primary; overflow: elide; }
                            Text { text: row.artist; horizontal-stretch: 2; min-width: 0; preferred-width: 0; vertical-alignment: center; color: row.is-current ? Theme.accent-text : Theme.text-primary; overflow: elide; }
                            Text { text: row.album; horizontal-stretch: 2; min-width: 0; preferred-width: 0; vertical-alignment: center; color: row.is-current ? Theme.accent-text : Theme.text-muted; overflow: elide; }
                            Text { text: row.duration; width: 52px; vertical-alignment: center; color: row.is-current ? Theme.accent-text : Theme.text-primary; }
                        }
                        if !root.list-view: HorizontalLayout {
                            padding-left: 76px;
                            padding-right: 4px;
                            spacing: 4px;
                            Text { text: row.track-number; width: 30px; vertical-alignment: center; color: row.is-current ? Theme.accent-text : Theme.text-primary; }
                            Text { text: row.title; horizontal-stretch: 1; vertical-alignment: center; color: row.is-current ? Theme.accent-text : Theme.text-primary; overflow: elide; }
                            Text { text: row.duration; width: 60px; vertical-alignment: center; color: row.is-current ? Theme.accent-text : Theme.text-primary; }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 28px;
            background: Theme.bg-raised;
            HorizontalLayout {
                padding: 2px;
                LineEdit {
                    placeholder-text: "Type a search query and press Enter";
                    font-size: 12px;
                    edited(text) => { root.search-edited(text); }
                    accepted(text) => { root.search-edited(text); }
                }
            }
        }
    }
}
